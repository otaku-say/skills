#!/bin/sh
# Resolve the bundled executable for this host without a global installation.
set -u
DIR="$(cd "$(dirname "$0")" && pwd)"
case "$(uname -m)" in
  aarch64|arm64) ARCH=aarch64 ;;
  x86_64|amd64) ARCH=x86_64 ;;
  *) echo "Unsupported architecture: $(uname -m)" >&2; exit 126 ;;
esac
BIN="$DIR/aiod-cli-$ARCH-linux-musl"

[ -f "$BIN" ] || { echo "Missing binary $BIN; run sh $DIR/update.sh" >&2; exit 127; }
[ -x "$BIN" ] || chmod +x "$BIN" 2>/dev/null || true
[ -x "$BIN" ] || { echo "Binary is not executable: $BIN" >&2; exit 126; }
exec "$BIN" "$@"
