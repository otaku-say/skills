#!/bin/sh
# 按当前系统架构选择本技能目录内的 CLI。
set -u
DIR="$(cd "$(dirname "$0")" && pwd)"
case "$(uname -m)" in
  aarch64|arm64) ARCH=arm64 ;;
  x86_64|amd64) ARCH=amd64 ;;
  *) echo "不支持的处理器架构：$(uname -m)" >&2; exit 126 ;;
esac
BIN="$DIR/$ARCH/aiod-cli"

[ -f "$BIN" ] || { echo "缺少二进制文件 $BIN；请运行 sh $DIR/update.sh" >&2; exit 127; }
[ -x "$BIN" ] || chmod +x "$BIN" 2>/dev/null || true
[ -x "$BIN" ] || { echo "二进制文件不可执行：$BIN" >&2; exit 126; }
exec "$BIN" "$@"
